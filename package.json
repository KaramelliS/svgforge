{
  "name": "@kodyazicam/svgforge",
  "version": "2.2.0",
  "private": true,
  "description": "Generate GitHub README SVGs locally: banners, stats, skills, terminals, badges, dividers, progress, donuts, charts, links, quotes, code, projects, waves. No third-party render service.",
  "keywords": [
    "svg",
    "readme",
    "github",
    "badge",
    "card",
    "cli",
    "banner",
    "donut",
    "chart",
    "wave"
  ],
  "license": "SEE LICENSE IN LICENSE",
  "author": "Batuhan (KodYazicam) <https://github.com/KodYazicam>",
  "homepage": "https://github.com/KodYazicam/svgforge",
  "repository": {
    "type": "git",
    "url": "https://github.com/KodYazicam/svgforge.git"
  },
  "type": "module",
  "bin": {
    "svgforge": "./dist/cli.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "test": "vitest run",
    "examples": "node dist/cli.js render examples/demo.json -o examples/",
    "typecheck": "tsc -p tsconfig.build.json --noEmit"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "typescript": "^5.7.0",
    "vitest": "^2.1.0"
  }
}
